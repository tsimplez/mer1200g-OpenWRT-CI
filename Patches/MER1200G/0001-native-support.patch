diff --git a/target/linux/ramips/patches-6.18/334-mt7620-avoid-direct-jal-in-timing-entropy.patch b/target/linux/ramips/patches-6.18/334-mt7620-avoid-direct-jal-in-timing-entropy.patch
new file mode 100644
index 0000000000..a2a1462842
--- /dev/null
+++ b/target/linux/ramips/patches-6.18/334-mt7620-avoid-direct-jal-in-timing-entropy.patch
@@ -0,0 +1,61 @@
+Subject: [PATCH] random: keep MT7620 timing-entropy mixing calls indirect
+
+A MER1200G RAM boot faulted at 0x703ec504 while a direct JAL at
+0x8000410c targeted mix_pool_bytes() at 0x803ec504. The saved return
+address was 0x80004114. The old and new kernel text at this path is
+identical, so a successful boot did not exclude this intermittent case.
+
+Apply the same volatile-function-pointer pattern already used by the
+ramips MT7620 random-helper and resume-user-mode workarounds. Limit it
+to the three mixing calls in the timing-entropy sampler and its timer
+callback. Always inline the wrapper so no new direct call replaces the
+observed one. Other SoCs retain the ordinary call.
+
+Keep all entropy samples, pool mixing, crediting, readiness tests, timer
+lifecycle and scheduling intact; do not bypass RNG initialization.
+
+---
+--- a/drivers/char/random.c
++++ b/drivers/char/random.c
+@@ -1254,6 +1254,18 @@
+ 	unsigned int samples_per_bit;
+ };
+ 
++/* Keep the timing-entropy mix calls indirect on affected MT7620 builds. */
++static __always_inline void mix_timing_entropy(const void *buf, size_t len)
++{
++#ifdef CONFIG_NET_RALINK_MT7620
++	void (*volatile mix_fn)(const void *, size_t) = mix_pool_bytes;
++
++	mix_fn(buf, len);
++#else
++	mix_pool_bytes(buf, len);
++#endif
++}
++
+ /*
+  * Each time the timer fires, we expect that we got an unpredictable jump in
+  * the cycle counter. Even if the timer is running on another CPU, the timer
+@@ -1270,7 +1282,7 @@
+ 	struct entropy_timer_state *state = container_of(timer, struct entropy_timer_state, timer);
+ 	unsigned long entropy = random_get_entropy();
+ 
+-	mix_pool_bytes(&entropy, sizeof(entropy));
++	mix_timing_entropy(&entropy, sizeof(entropy));
+ 	if (atomic_inc_return(&state->samples) % state->samples_per_bit == 0)
+ 		credit_init_bits(1);
+ }
+@@ -1341,11 +1353,11 @@
+ 
+ 			preempt_enable();
+ 		}
+-		mix_pool_bytes(&stack->entropy, sizeof(stack->entropy));
++		mix_timing_entropy(&stack->entropy, sizeof(stack->entropy));
+ 		schedule();
+ 		stack->entropy = random_get_entropy();
+ 	}
+-	mix_pool_bytes(&stack->entropy, sizeof(stack->entropy));
++	mix_timing_entropy(&stack->entropy, sizeof(stack->entropy));
+ 
+ 	free_cpumask_var(timer_cpus);
+ out:
