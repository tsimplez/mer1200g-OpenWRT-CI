+
 define Build/elecom-header
 	cp $@ $(KDIR)/v_0.0.0.bin
 	( \
@@ -819,6 +830,29 @@ define Device/linksys_e1700
 endef
 TARGET_DEVICES += linksys_e1700
 
+define Device/mercury_mer1200g-v1
+  SOC := mt7620a
+  DEVICE_VENDOR := Mercury
+  DEVICE_MODEL := MER1200G
+  DEVICE_VARIANT := v1
+  DEVICE_DTS := mt7620a_mercury_mer1200g-v1 mt7620a_mercury_mer1200g-v1-initramfs
+  DEVICE_PACKAGES := kmod-mt76x2 kmod-switch-rtl8367b
+  KERNEL_LOADADDR := 0x80000000
+  KERNEL_ENTRY := 0x80000400
+  KERNEL_DEPENDS := $(TOPDIR)/scripts/mer1200g-image.py
+  KERNEL := mer1200g-kernel
+  KERNEL_INITRAMFS := mer1200g-kernel initramfs
+  KERNEL_INITRAMFS_SUFFIX := -kernel.RAM-ONLY.bin
+  IMAGE_SIZE := 13248k
+  FILESYSTEMS := squashfs
+  # The uImage length locates rootfs; neither kernel nor rootfs has a fixed size.
+  IMAGE/sysupgrade.bin := append-kernel | pad-to $$$$(BLOCKSIZE) | \
+	append-rootfs | pad-rootfs | check-size | append-metadata
+  # Keep this experimental board opt-in until the new kernel is boot-tested.
+  DEFAULT := n
+endef
+TARGET_DEVICES += mercury_mer1200g-v1
+
 define Device/microduino_microwrt
   SOC := mt7620a
   IMAGE_SIZE := 16128k
