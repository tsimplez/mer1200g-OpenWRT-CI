diff --git a/target/linux/ramips/patches-6.18/333-MIPS-ralink-use-appended-DT-for-MER1200G.patch b/target/linux/ramips/patches-6.18/333-MIPS-ralink-use-appended-DT-for-MER1200G.patch
new file mode 100644
index 0000000000..ea4113cbeb
--- /dev/null
+++ b/target/linux/ramips/patches-6.18/333-MIPS-ralink-use-appended-DT-for-MER1200G.patch
@@ -0,0 +1,89 @@
+Subject: [PATCH] MIPS: ralink: use the appended DT for MER1200G vendor boot
+
+The MER1200G v1 vendor U-Boot does not pass a usable argc/argv pair to
+the kernel.  Selecting the DT command line later in setup_arch() is too
+late: prom_init_cmdline() already dereferences those firmware arguments.
+
+Identify this board from the raw appended DT before parsing argv.  Check
+the header and limit the blob to the 1 MiB reserved by vmlinux.lds.S before
+reading its root compatible.  Use that same DT for memory setup and leave
+the existing command line and DT selection paths intact for other boards.
+
+This deliberately does not change the kernel entry point, appended DT
+layout, or the handling of bootloader arguments on other Ralink boards.
+
+---
+
+--- a/arch/mips/ralink/common.h
++++ b/arch/mips/ralink/common.h
+@@ -23,6 +23,7 @@ extern struct ralink_soc_info soc_info;
+ 
+ extern void ralink_of_remap(void);
+ 
++void *__init ralink_mer1200g_appended_dtb(void);
+ extern void __init prom_soc_init(struct ralink_soc_info *soc_info);
+ 
+ #endif /* _RALINK_COMMON_H__ */
+--- a/arch/mips/ralink/of.c
++++ b/arch/mips/ralink/of.c
+@@ -10,6 +10,7 @@
+ #include <linux/clk.h>
+ #include <linux/export.h>
+ #include <linux/init.h>
++#include <linux/libfdt.h>
+ #include <linux/sizes.h>
+ #include <linux/of_fdt.h>
+ #include <linux/kernel.h>
+@@ -84,6 +85,27 @@ void __init ralink_of_remap(void)
+ 		panic("Failed to remap core resources");
+ }
+ 
++void *__init ralink_mer1200g_appended_dtb(void)
++{
++	void *dtb = __appended_dtb;
++
++	if (!IS_ENABLED(CONFIG_SOC_MT7620) ||
++	    !IS_ENABLED(CONFIG_MIPS_RAW_APPENDED_DTB))
++		return NULL;
++
++	/*
++	 * The raw appended DT has a 1 MiB reservation in vmlinux.lds.S.
++	 * Validate its bounds before looking up the board's compatible.
++	 */
++	if (fdt_check_header(dtb) || fdt_totalsize(dtb) > SZ_1M)
++		return NULL;
++
++	if (fdt_node_check_compatible(dtb, 0, "mercury,mer1200g-v1"))
++		return NULL;
++
++	return dtb;
++}
++
+ void __init plat_mem_setup(void)
+ {
+ 	void *dtb;
