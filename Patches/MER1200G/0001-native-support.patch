diff --git a/scripts/mer1200g-image.py b/scripts/mer1200g-image.py
new file mode 100644
index 0000000000..0064a5d27f
--- /dev/null
+++ b/scripts/mer1200g-image.py
@@ -0,0 +1,198 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Build the single-component multi-uImage required by MER1200G's U-Boot.
+
+This only packages local build outputs. Passing these checks does not establish
+that a new kernel boots, or make this image suitable for the stock web updater.
+"""
+
+import argparse
+import lzma
+import struct
+import subprocess
+from pathlib import Path
+import zlib
+
+
+LOAD = 0x80000000
+ENTRY = 0x80000400
+STAGING = 0x82000000
+FLASH_SIZE = 0x1000000
+FIRMWARE_START = 0x40000
+FIRMWARE_SIZE = 0xCF0000
+LZMA_PROPERTIES = bytes.fromhex("6d00008000")
+
+
+def require(condition, message):
+    if not condition:
+        raise ValueError(message)
+
+
+def dtb_nodes(data):
+    """Read the properties needed for the board/layout checks without libfdt."""
+    require(len(data) >= 40, "truncated DTB")
+    magic, size, off_struct, off_strings, _, version, last, _, strings_size, struct_size = \
+        struct.unpack_from(">10I", data)
+    require(magic == 0xD00DFEED and size == len(data), "invalid DTB size or magic")
+    require(version >= 17 and last <= 17, "unsupported DTB version")
+    require(off_struct + struct_size <= size and off_strings + strings_size <= size,
+            "DTB block outside the image")
+    strings = data[off_strings:off_strings + strings_size]
+    end = off_struct + struct_size
+    cursor = off_struct
+    stack = []
+    nodes = {}
+    while cursor + 4 <= end:
+        token, = struct.unpack_from(">I", data, cursor)
+        cursor += 4
+        if token == 1:  # FDT_BEGIN_NODE
+            stop = data.find(b"\0", cursor, end)
+            require(stop >= cursor, "unterminated DTB node name")
+            stack.append(data[cursor:stop].decode("ascii"))
+            path = "/" + "/".join(stack[1:])
+            require(path not in nodes, "duplicate DTB node")
+            nodes[path] = {}
+            cursor = (stop + 4) & ~3
+        elif token == 2:  # FDT_END_NODE
+            require(stack, "unbalanced DTB node")
+            stack.pop()
+        elif token == 3:  # FDT_PROP
+            require(stack and cursor + 8 <= end, "invalid DTB property")
+            length, nameoff = struct.unpack_from(">II", data, cursor)
+            cursor += 8
+            stop = strings.find(b"\0", nameoff)
+            require(0 <= nameoff < len(strings) and stop >= nameoff and
+                    cursor + length <= end, "DTB property outside its block")
+            name = strings[nameoff:stop].decode("ascii")
+            props = nodes["/" + "/".join(stack[1:])]
+            require(name not in props, "duplicate DTB property")
+            props[name] = data[cursor:cursor + length]
+            cursor = (cursor + length + 3) & ~3
+        elif token == 4:  # FDT_NOP
+            continue
+        elif token == 9:  # FDT_END
+            require(not stack and "/" in nodes, "incomplete DTB")
+            return nodes
+        else:
+            raise ValueError("invalid DTB token")
+    raise ValueError("missing DTB end token")
+
+
+def check_dtb(data, initramfs):
+    nodes = dtb_nodes(data)
+    require(b"mercury,mer1200g-v1" in nodes["/"].get("compatible", b"").split(b"\0"),
+            "DTB is not for MER1200G v1")
+    parts = []
+    for path, props in nodes.items():
+        require("linux,rootfs" not in props, "DTB must not force a flash rootfs")
+        require(props.get("label") not in (b"kernel\0", b"rootfs\0", b"rootfs_data\0"),
+                "use a dynamic firmware partition, not fixed kernel/rootfs partitions")
+        if path.rsplit("/", 1)[0].rsplit("/", 1)[-1] != "partitions":
+            continue
+        require(len(props.get("reg", b"")) == 8, "invalid flash partition range")
+        offset, size = struct.unpack(">II", props["reg"])
+        require(size > 0, "empty flash partition")
+        parts.append((offset, size, props))
+
+    cursor = 0
+    firmware = None
+    for offset, size, props in sorted(parts, key=lambda part: part[0]):
+        require(offset == cursor, "flash partitions overlap or leave a gap")
+        cursor += size
+        if offset == FIRMWARE_START and size == FIRMWARE_SIZE:
+            firmware = props
+        else:
+            require("read-only" in props, "a protected flash partition is writable")
+        if initramfs:
+            require("read-only" in props, "initramfs exposes a writable flash partition")
+    require(cursor == FLASH_SIZE and firmware is not None, "unexpected 16 MiB flash layout")
+
+    if initramfs:
+        require(firmware.get("label") == b"firmware-readonly\0" and
+                "compatible" not in firmware and "openwrt,ih-type" not in firmware,
+                "initramfs must disable automatic firmware splitting")
+        chosen = nodes.get("/chosen", {})
+        for prop in ("bootargs", "bootargs-override"):
+            require(chosen.get(prop) == b"console=ttyS0,115200\0",
+                    "initramfs boot arguments must not select flash storage")
+    else:
+        require(firmware.get("label") == b"firmware\0" and "read-only" not in firmware,
+                "persistent firmware partition is missing or read-only")
+        require(b"openwrt,uimage" in firmware.get("compatible", b"").split(b"\0") and
+                firmware.get("openwrt,ih-type") == struct.pack(">I", 4),
+                "firmware parser must accept IH_TYPE_MULTI")
+
+
+def check_kernel(raw, elf_path, nm, dtb_size):
+    with elf_path.open("rb") as elf:
+        header = elf.read(52)
+    require(len(header) == 52 and header[:7] == b"\x7fELF\x01\x01\x01" and
+            struct.unpack_from("<H", header, 18)[0] == 8,
+            "kernel ELF must be 32-bit little-endian MIPS")
+    elf_entry, = struct.unpack_from("<I", header, 24)
+    names = {"__kernel_entry", "kernel_entry", "__appended_dtb", "_end"}
+    symbols = {}
+    listing = subprocess.check_output([nm, "-P", "--defined-only", str(elf_path)], text=True)
+    for line in listing.splitlines():
+        fields = line.split()
+        if fields and fields[0] in names:
+            require(len(fields) >= 3 and fields[0] not in symbols, "ambiguous kernel symbol")
+            symbols[fields[0]] = int(fields[2], 16)
+    require(symbols.keys() == names, "kernel ELF is missing required entry/DTB symbols")
+    require(symbols["__kernel_entry"] == ENTRY and symbols["kernel_entry"] == elf_entry,
+            "kernel entry does not match the vendor boot address")
+    require(len(raw) == symbols["__appended_dtb"] - LOAD and len(raw) > ENTRY - LOAD + 4,
+            "raw kernel does not end at __appended_dtb")
+    jump, = struct.unpack_from("<I", raw, ENTRY - LOAD)
+    target = ((ENTRY + 4) & 0xF0000000) | ((jump & 0x03FFFFFF) << 2)
+    require(jump >> 26 == 2 and target == elf_entry, "missing MIPS entry jump at 0x80000400")
+    require(LOAD < symbols["_end"] < STAGING and LOAD + len(raw) + dtb_size < STAGING,
+            "expanded kernel/DTB overlaps the required 0x82000000 staging address")
+
+
+def multi_image(expanded, timestamp, name):
+    require(0 < len(expanded) < STAGING - LOAD, "expanded image exceeds the boot window")
+    require(0 <= timestamp <= 0xFFFFFFFF, "uImage timestamp is outside uint32")
+    compressed = lzma.compress(expanded, format=lzma.FORMAT_ALONE, filters=[{
+        "id": lzma.FILTER_LZMA1, "dict_size": 8 * 1024 * 1024,
+        "lc": 1, "lp": 2, "pb": 2,
+    }])
+    require(compressed[:5] == LZMA_PROPERTIES, "unexpected vendor LZMA properties")
+    # U-Boot's decoder rejects the unknown-length marker used by liblzma.
+    compressed = compressed[:5] + struct.pack("<Q", len(expanded)) + compressed[13:]
+    require(lzma.decompress(compressed, format=lzma.FORMAT_ALONE) == expanded,
+            "LZMA round-trip check failed")
+    # One component, then the terminating zero; the final component is unpadded.
+    payload = struct.pack(">II", len(compressed), 0) + compressed
+    header = struct.pack(">7I4B32s", 0x27051956, 0, timestamp, len(payload), LOAD, ENTRY,
+                         zlib.crc32(payload), 5, 5, 4, 3, name.encode("ascii")[:32])
+    header = header[:4] + struct.pack(">I", zlib.crc32(header)) + header[8:]
+    return header + payload
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--kernel", type=Path, required=True)
+    parser.add_argument("--elf", type=Path, required=True)
+    parser.add_argument("--dtb", type=Path, required=True)
+    parser.add_argument("--nm", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--timestamp", type=int, default=0)
+    parser.add_argument("--name", default="MER1200G ImmortalWrt")
+    parser.add_argument("--initramfs", action="store_true")
+    args = parser.parse_args()
+    try:
+        raw = args.kernel.read_bytes()
+        dtb = args.dtb.read_bytes()
+        check_dtb(dtb, args.initramfs)
+        check_kernel(raw, args.elf, args.nm, len(dtb))
+        image = multi_image(raw + dtb, args.timestamp, args.name)
+        if not args.initramfs:
+            require(len(image) < FIRMWARE_SIZE, "kernel alone fills the firmware partition")
+        args.output.write_bytes(image)
+    except (OSError, ValueError, lzma.LZMAError, subprocess.CalledProcessError) as error:
+        parser.exit(1, "MER1200G image: {}\n".format(error))
+
+
+if __name__ == "__main__":
+    main()
